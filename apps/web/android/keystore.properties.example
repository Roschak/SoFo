# Copy to keystore.properties (gitignored) and fill in your real values.
# Generate a keystore with the JDK keytool:
#   keytool -genkeypair -v -keystore sofo-release.jks -alias sofo \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=C\:\\path\\to\\sofo-release.jks
storePassword=CHANGE_ME
keyAlias=sofo
keyPassword=CHANGE_ME
