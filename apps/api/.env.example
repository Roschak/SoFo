# SOFO API — copy to .env and adjust per environment (PRD §135)
NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://sofo:sofo_dev@localhost:5433/sofo?schema=public
SESSION_TTL_HOURS=72
UPLOAD_DIR=../../data/uploads
# Multi-origin (comma-separated) — Capacitor shell + Tauri EXE + LAN testers (Phase 26 beta)
CORS_ORIGIN=http://localhost:5173,http://10.0.2.2:5173,https://localhost,http://tauri.localhost
